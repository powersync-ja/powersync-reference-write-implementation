# Only for running the backend directly on the host (`pnpm dev` / `pnpm start`). Docker Compose
# uses the root .env instead; see the root README. Stop the Compose backend first: both use port 6060.

# One of: postgres, mongodb, mysql, mssql
DATABASE_TYPE=postgres
# Required. The backend refuses to start without it.
DATABASE_URI=

# Auth config defaults to backend/config/powersync-config.json, relative to the source module.
# Set an absolute path to use a different export. See docs/auth/setup.md.
# POWERSYNC_CONFIG_PATH=/absolute/path/to/powersync-config.json

PORT=6060

# Backend-directed fatal failures: stop the batch (default) or skip and continue.
BATCH_ON_FATAL_ERROR=stop

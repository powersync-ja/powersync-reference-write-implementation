# Docker Compose reads this automatically and passes it to the backend, followed by an optional,
# gitignored .env.local that overrides it (this machine's values and secrets, e.g. DATABASE_URI).
# Append :docker-compose.dev.yaml to COMPOSE_FILE for the hot-reload dev loop:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.yaml

# Token verification: what the PowerSync export cannot tell the verifier is set with AUTH_*
# variables, for example AUTH_ISSUER and AUTH_AUDIENCE (comma-separated). They belong with the
# machine and provider in use, so usually in .env.local. See backend/src/auth/SETUP.md.

# Backend-directed fatal failures: stop the batch (default) or skip and continue.
BATCH_ON_FATAL_ERROR=stop

# One of: postgres, mongodb, mysql, mssql
DATABASE_TYPE=postgres
# Required. The backend refuses to start without it.
DATABASE_URI=

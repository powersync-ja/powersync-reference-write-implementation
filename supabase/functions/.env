# Local development only (`supabase start` / `supabase functions serve`). Do not upload as hosted secrets:
# hosted projects derive both values from the injected SUPABASE_URL and SUPABASE_DB_URL.

# Tokens from the local stack are issued by the public URL, not the runtime's internal SUPABASE_URL.
POWERSYNC_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# The injected local SUPABASE_DB_URL host contains underscores, which the edge runtime cannot resolve.
POWERSYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
